{
  "$schema": "visual.contract.v1",
  "version": 0,
  "lockedAt": null,
  "_note": "v0 placeholder. Iris fills this during Stage 3 (three art directions). Once the human picks a direction (Stage 4), Iris sets version=1 and lockedAt. From then on, changes are versioned bumps with a DESIGN_RATIONALE.md entry.",
  "colour": {
    "space": "oklch",
    "ramps": {
      "neutral": { "steps": 12, "hue": 264, "chromaCurve": "0.004->0.021" },
      "accent":  { "steps": 12, "hue": 22,  "chromaCurve": "0.03->0.19" },
      "positive":{ "steps": 8,  "hue": 152 },
      "critical":{ "steps": 8,  "hue": 24 }
    },
    "semantic": {
      "surface.base":    { "light": "neutral.1",  "dark": "neutral.12" },
      "surface.raised":  { "light": "neutral.0",  "dark": "neutral.11" },
      "text.primary":    { "light": "neutral.12", "dark": "neutral.1"  },
      "text.secondary":  { "light": "neutral.9",  "dark": "neutral.5"  },
      "border.subtle":   { "light": "neutral.4",  "dark": "neutral.10" },
      "accent.solid":    { "light": "accent.9",   "dark": "accent.8"   },
      "focus.ring":      { "light": "accent.7",   "dark": "accent.7"   }
    },
    "contrastFloor": { "body": 4.5, "large": 3.0, "nonText": 3.0 }
  },
  "type": {
    "families": {
      "display": { "stack": "\"<VariableSerif>\", Georgia, serif", "selfHosted": true, "opticalSizing": true },
      "text":    { "stack": "\"<VariableSans>\", system-ui, sans-serif", "selfHosted": true },
      "mono":    { "stack": "\"<VariableMono>\", ui-monospace, monospace", "selfHosted": true }
    },
    "scale": { "base": 16, "ratio": 1.2, "steps": [-2,-1,0,1,2,3,4,5,6] },
    "leading": { "tight": 1.1, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "display": "-0.02em", "body": "0", "caps": "0.06em" },
    "features": { "numeric": "tnum", "quotes": "liga" }
  },
  "space": { "unit": 4, "steps": [0,1,2,3,4,6,8,12,16,24,32,48,64,96] },
  "radius": { "sm": 6, "md": 10, "lg": 16, "xl": 24, "full": 9999, "nested": "outer - gap" },
  "elevation": {
    "policy": "layered-or-none",
    "raised": ["0 1px 1px oklch(0 0 0/.04)", "0 2px 4px oklch(0 0 0/.04)", "0 8px 16px oklch(0 0 0/.04)"],
    "overlay": ["0 2px 4px oklch(0 0 0/.06)", "0 12px 24px oklch(0 0 0/.08)", "0 32px 64px oklch(0 0 0/.10)"]
  },
  "motion": {
    "durations": { "instant": 80, "fast": 140, "base": 220, "slow": 360, "enter": 260, "exit": 180 },
    "easing": {
      "standard": "cubic-bezier(.2,0,0,1)",
      "decel":    "cubic-bezier(.05,.7,.1,1)",
      "accel":    "cubic-bezier(.3,0,.8,.15)",
      "spring":   "cubic-bezier(.34,1.56,.64,1)"
    },
    "animatableProperties": ["transform", "opacity", "filter"],
    "reducedMotion": "durations->0, opacity-only crossfade"
  },
  "density": { "control.height": { "sm": 32, "md": 40, "lg": 48 }, "hitTarget.min": 44 },
  "surfaceTexture": { "noiseOpacity": 0.015, "gradientMesh": "allowed-on-marketing-only" }
}
